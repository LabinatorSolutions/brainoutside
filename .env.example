# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Everything here is infrastructure; the Claude
# credential, model choices and budgets are NOT env vars — they live encrypted
# in the database and are set on the Settings page after first boot.
#
# Coolify trap: an env var set to an empty string is treated as UNSET by this
# app, on purpose. Delete the line instead of blanking it.
# ---------------------------------------------------------------------------

# ----- Identity -------------------------------------------------------------
# Shown in the browser tab, the landing page and the login screen.
APP_NAME=BrainOutside

# ----- Django core ----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.docker
DEBUG=false
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Encrypts the Claude credential at rest in the DB. Rotating it makes every
# stored secret unreadable — back it up with your database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000

# ----- Where the ops UI lives ----------------------------------------------
# The ops UI can approve feeds and read every private note. Keep these paths
# non-obvious AND put the whole prefix behind a network boundary (Tailscale,
# Cloudflare Access, or ADMIN_IP_ALLOWLIST) — see docs/SECURITY.md.
ADMIN_PANEL_URL_PATH=ops/
DJANGO_ADMIN_URL_PATH=_django-admin-CHANGE-ME/
# Comma-separated CIDRs allowed to reach the ops prefix. Empty = no IP check.
ADMIN_IP_ALLOWLIST=

# ----- Data stores ----------------------------------------------------------
# Compose builds DATABASE_URL from this; set it to anything for local dev.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# ----- The brain repo -------------------------------------------------------
# The git repo that IS your brain. Start from the brain-template repo.
# Leave BRAIN_REPO_URL empty to use a clone you mount yourself (local dev).
BRAIN_REPO_URL=
BRAIN_REPO_DIR=/data/brain-repo
BRAIN_VIEWS_DIR=/data/brain-views

# Read-only deploy key used for cloning and every routine pull.
BRAIN_GIT_SSH_KEY_PATH=/run/secrets/brain_deploy_key

# The WRITE credential — a fine-grained PAT with contents:write on this ONE
# repo. Deliberately separate from the read key and mounted ONLY in the worker
# container: a stolen read key leaks, a stolen write key poisons the mind.
# Approval pushes are disabled cleanly when this is absent.
BRAIN_GIT_WRITE_PAT_PATH=/run/secrets/brain_write_pat

# Author on approval commits, so server writes are distinguishable from yours.
BRAIN_COMMIT_NAME=brain-app
BRAIN_COMMIT_EMAIL=brain-app@localhost

# Shared secret for GitHub's push webhook (HMAC-verified). Without it the
# server still picks up pushes on its periodic pull, just more slowly.
# python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Largest payload `propose-feed` accepts — raise it for long transcripts.
FEED_PAYLOAD_MAX_KB=512
